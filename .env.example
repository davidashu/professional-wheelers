# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API). The anon/publishable key is safe in the
# browser; the service-role key is SERVER-ONLY and must never be exposed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app, used to build customer quote links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the public form header and quote emails.
COMPANY_NAME=Your Auto Transport Co.

# Secrets: generate each with `openssl rand -base64 48` (32+ characters).
# QUOTE_LINK_SECRET derives customer quote links. Changing it breaks existing
# links (staff can "Issue new link" on active quotes).
QUOTE_LINK_SECRET=
# APP_SECRET signs form tokens (spam protection) and hashes visitor IPs.
APP_SECRET=

# ---------------------------------------------------------------------------
# Optional: quote emails via Resend (https://resend.com). Without these,
# staff copy the quote link and send it themselves.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Quotes <quotes@yourdomain.com>"
EMAIL_REPLY_TO=
# Webhook signing secret (whsec_...) for delivered/bounced status updates.
# Point a Resend webhook at <NEXT_PUBLIC_SITE_URL>/api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Monthly profit-drop sequences. Vercel Cron calls /api/cron/sequences on the
# 1st of each month (vercel.json) with "Authorization: Bearer $CRON_SECRET".
# Generate with `openssl rand -base64 48` (32+ characters).
# ---------------------------------------------------------------------------
CRON_SECRET=
